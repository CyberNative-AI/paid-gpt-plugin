{
  // One Worker: OAuth authorization server, sign-in page and the gated MCP endpoint.
  "name": "paid-gpt-plugin",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "kv_namespaces": [
    // Tokens, grants and registered clients (managed by @cloudflare/workers-oauth-provider).
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_ID" },
    // Your customer list and short-lived entitlement checks.
    { "binding": "ENTITLEMENTS", "id": "REPLACE_WITH_KV_ID" }
  ],
  // Sign-in throttles (atomic per Cloudflare location): per client IP and per email.
  "ratelimits": [
    { "name": "SIGNIN_IP_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "SIGNIN_EMAIL_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  // Secret: USER_ID_SECRET (32+ random characters). `npx wrangler secret put USER_ID_SECRET`;
  // for local dev put it in .dev.vars.
  "vars": {
    // The public HTTPS origin of this Worker, without a trailing slash.
    "PUBLIC_ORIGIN": "http://localhost:8787",
    // "allowlist" (you issue access keys) or "gumroad" (customers use their Gumroad license key).
    "ENTITLEMENT_MODE": "allowlist",
    // Required for gumroad mode: the product ID from your Gumroad product page.
    "GUMROAD_PRODUCT_ID": "",
    // Domain verification token shown in the plugin dashboard (served at /.well-known/openai-apps-challenge).
    "OPENAI_APPS_CHALLENGE": "",
    // Hosts allowed to receive sign-in codes: ChatGPT, and loopback for local tools such as MCP Inspector.
    "ALLOWED_REDIRECT_HOSTS": "chatgpt.com,localhost,127.0.0.1"
  }
}
